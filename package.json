{
  "name": "airmonlink-composer",
  "version": "1.1.9",
  "description": "Airmonlink Composer - intelligent music notation, harmony and tonic sol-fa desktop application",
  "main": "src/composer3/main.js",
  "author": "Airmonlink",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/lint.js",
    "validate": "npm run lint && npm test",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "preview": "node scripts/build-preview.js",
    "browser-smoke": "node scripts/browser-smoke.js",
    "validate:full": "npm run validate && npm run performance && npm run preview && npm run browser-smoke && npm run viewport-matrix",
    "performance": "node scripts/performance-audit.js",
    "viewport-matrix": "node scripts/viewport-matrix.js"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.airmonlink.composer",
    "productName": "Airmonlink Composer 3",
    "buildVersion": "1.1.9.29",
    "artifactName": "Airmonlink-Composer-${version}-Build29-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/composer3/**/*",
      "src/core/**/*",
      "src/desktop/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Airmonlink-Composer-${version}-Build29-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Airmonlink-Composer-${version}-Build29-Portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "airscore",
        "name": "Airmonlink Composer 3 Score",
        "description": "Airmonlink Composer 3 editable score",
        "role": "Editor",
        "icon": "assets/icon.ico"
      }
    ]
  },
  "buildNumber": "29"
}
